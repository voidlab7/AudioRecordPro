  "decisions": {
    "tabNaming": {
      "tab1": "INPUT",
      "tab2": "FILES",
      "icon1": "waveform (保留)",
      "icon2": "folder (保留)",
      "rationale": "简洁大写英文，符合 Industrial Design 风格，与应用名去重"
    },
    "autoSwitch": {
      "trigger": "handleRecordingComplete → switchToFilesTabAndHighlight()",
      "animationDuration": "250ms",
      "type": "crossfade (NSAnimationContext)",
      "condition": "仅在当前非 FILES Tab 时切换",
      "totalLatency": "≤350ms 到达 FILES Tab"
    },
    "highlight": {
      "color": "#22d3ee (IndustrialColors.primaryContainer)",
      "maxOpacity": 0.30,
      "totalDuration": "2500ms",
      "phases": ["fadeIn: 0→0.25 in 250ms", "pulse: 0.15↔0.30 in 1250ms", "fadeOut: 0.15→0 in 1000ms"],
      "implementation": "CAAnimationGroup on dedicated highlightLayer",
      "interruptible": true
    },
    "splitPane": {
      "adopted": false,
      "reason": "240px 宽度下垂直空间不足（需 ≥530px），Tab 模式 + 自动切换已解决痛点"
    }
  },
